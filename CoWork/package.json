{
  "name": "cowork",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,gateway,auth,spaces,bookings,addons -c cyan,magenta,yellow,green,blue,red \"npm:dev:web\" \"npm:dev:gateway\" \"npm:dev:auth\" \"npm:dev:spaces\" \"npm:dev:bookings\" \"npm:dev:addons\"",
    "dev:web": "npm run dev --workspace @cowork/web",
    "dev:gateway": "npm run dev --workspace @cowork/gateway",
    "dev:auth": "npm run dev --workspace @cowork/auth",
    "build": "npm run build --workspace @cowork/web",
    "smoke": "node scripts/smoke.mjs",
    "dev:spaces": "npm run dev --workspace @cowork/spaces",
    "dev:bookings": "npm run dev --workspace @cowork/bookings",
    "dev:addons": "npm run dev --workspace @cowork/addons"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
