{
  "name": "cowork",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,gateway,auth -c cyan,magenta,yellow \"npm:dev:web\" \"npm:dev:gateway\" \"npm:dev:auth\"",
    "dev:web": "npm run dev --workspace @cowork/web",
    "dev:gateway": "npm run dev --workspace @cowork/gateway",
    "dev:auth": "npm run dev --workspace @cowork/auth",
    "build": "npm run build --workspace @cowork/web",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
